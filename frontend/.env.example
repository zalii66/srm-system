# 前端环境变量配置示例
# 复制此文件为 .env.development 或 .env.production 并根据需要修改

# API 基础URL
# 开发环境：留空使用代理，或设置为后端URL（如：http://127.0.0.1:8001）
# 生产环境：必须设置（如：https://api.example.com/api/v1）
# 如果前后端同域，留空或设置为 /api/v1
VITE_API_BASE_URL=

# Vite 开发服务器端口
# 默认值：3000
VITE_DEV_PORT=3000

# Vite 代理目标（仅开发环境）
# 后端API地址，用于代理
# 默认值：http://127.0.0.1:8001
VITE_PROXY_TARGET=http://127.0.0.1:8001
